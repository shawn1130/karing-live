{
  "name": "@karing/live",
  "version": "0.1.0",
  "private": true,
  "description": "Live calls in your web app: a live call board, call audio and live transcripts from Karing, with full TypeScript types.",
  "keywords": [
    "karing",
    "live calls",
    "call audio",
    "transcripts",
    "react",
    "websocket"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
